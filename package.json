{
  "name": "deepcode-cli",
  "version": "0.1.0",
  "description": "DeepSeek native terminal coding agent",
  "type": "module",
  "bin": {
    "deepcode": "./dist/bin/deepcode.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/bin/deepcode.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/src/smoke.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "coding-agent",
    "cli",
    "ai",
    "terminal"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "openai": "^6.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
